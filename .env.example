# Public browser key; Vite exposes only VITE_* values.
VITE_CLERK_PUBLISHABLE_KEY=

# Server-only values. Never prefix these with VITE_.
CLERK_SECRET_KEY=
# Optional offline JWT verification key if configured by Clerk.
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://your-production-domain.example
DATABASE_URL=
PORT=5000
